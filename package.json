{
  "name": "codearena",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "description": "CodeArena: a coding practice and contest platform that runs Python and JavaScript in the browser.",
  "scripts": {
    "dev": "node scripts/dev-server.mjs 3000",
    "build:editor": "node scripts/build-editor.mjs",
    "test": "node --test tests/unit/*.test.js",
    "e2e": "python3 tests/e2e/run.py"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "pyodide": "^314.0.7"
  }
}
